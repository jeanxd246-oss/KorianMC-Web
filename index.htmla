  <!-- ========== PAGE: EQUIPO ========== -->
  <section class="page" data-page="equipo">
    <div class="page-head">
      <div class="container">
        <div class="sec-head">
          <span class="sec-label">EQUIPO</span>
          <h1 class="sec-title">Las personas detrás de <span class="accent-rgb">KorianMC</span></h1>
          <p class="sec-desc">Un proyecto fundado y dirigido por sus propietarios, con dedicación y compromiso en cada detalle.</p>
        </div>
      </div>
    </div>

    <section class="section-sm">
      <div class="container">
        <div class="team-grid">
          <article class="team-card programmer reveal reveal-left">
            <span class="team-watermark" aria-hidden="true">&lt;/&gt;</span>
            <div class="team-head">
              <div class="team-avatar avatar-image" role="img" aria-label="Jean"></div>
              <div>
                <h2 class="team-name">Jean</h2>
                <div class="team-role">Fundador y Propietario</div>
              </div>
            </div>
            <p class="team-desc">Se encarga del desarrollo técnico de KorianMC. Programación, configuración y cada sistema detrás de la experiencia del servidor.</p>
            <div class="team-badges">
              <span class="badge highlight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>Propietario</span>
              <span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Fundador</span>
              <span class="badge highlight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>Programador</span>
              <span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>Desarrollador</span>
            </div>
          </article>

          <article class="team-card reveal reveal-right">
            <div class="team-head">
              <div class="team-avatar">D</div>
              <div>
                <h2 class="team-name">Deyvi</h2>
                <div class="team-role">Fundador y Propietario</div>
              </div>
            </div>
            <p class="team-desc">Uno de los fundadores de KorianMC. Forma parte de la dirección del proyecto y contribuye a su crecimiento desde el primer día.</p>
            <div class="team-badges">
              <span class="badge highlight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>Propietario</span>
              <span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Fundador</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <div class="cta-wrap reveal reveal-scale">
          <div class="cta">
            <h2 class="cta-title">Fundadores y propietarios</h2>
            <p class="cta-desc">Jean y Deyvi son los fundadores y propietarios de KorianMC. Juntos dirigen el proyecto, combinando desarrollo técnico y gestión para construir una network sólida y en crecimiento.</p>
            <div class="cta-actions">
              <a href="#/informacion" class="btn btn-outline">Conocer el proyecto</a>
              <a href="#/comunidad" class="btn btn-primary">Unirse a la comunidad</a>
            </div>
          </div>
        </div>
