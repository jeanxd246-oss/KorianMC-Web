    </div>

    <div class="footer-bottom">
      <div>© 2026 KorianMC. Todos los derechos reservados.</div>
      <div class="footer-tag"><span class="dot"></span>Java &amp; Bedrock</div>
    </div>
  </div>
</footer>

<script>
(function(){
  'use strict';
  const ROUTES = ['inicio','studio','comunidad','equipo','tienda','informacion'];

  function getRoute(){
    const h = window.location.hash.replace(/^#\/?/, '').split('?')[0];
    if (!h) return 'inicio';
    return ROUTES.includes(h) ? h : 'inicio';
  }

  let observer = null;
  function revealIn(pageEl){
    if (observer) observer.disconnect();
    const els = pageEl.querySelectorAll('.reveal');
    els.forEach(el => el.classList.remove('visible'));
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.add('visible'));
      return;
    }
    observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: .10, rootMargin: '0px 0px -40px 0px' });
    els.forEach(el => observer.observe(el));
  }

  function navigate(){
    const route = getRoute();
    document.querySelectorAll('.page').forEach(p => {
      p.classList.toggle('active', p.dataset.page === route);
    });
    document.querySelectorAll('.nav-link, .mobile-link').forEach(l => {
      l.classList.toggle('active', l.dataset.route === route);
    });
    closeMenu();
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
    const active = document.querySelector(`.page[data-page="${route}"]`);
    if (active) requestAnimationFrame(() => revealIn(active));
  }

  window.addEventListener('hashchange', navigate);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', navigate);
  } else {
    navigate();
  }

  const navbar = document.getElementById('navbar');
  function onScroll(){
    navbar.classList.toggle('scrolled', window.scrollY > 12);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');
  function openMenu(){
    toggle.classList.add('open');
    menu.classList.add('open');
    toggle.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu(){
    toggle.classList.remove('open');
    menu.classList.remove('open');
    toggle.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
  }
  function toggleMenu(){
    if (menu.classList.contains('open')) closeMenu();
    else openMenu();
  }
  toggle.addEventListener('click', toggleMenu);
  document.querySelectorAll('.mobile-link').forEach(a => {
    a.addEventListener('click', () => setTimeout(closeMenu, 80));
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024 && menu.classList.contains('open')) closeMenu();
  });

  const toastWrap = document.getElementById('toastWrap');
  function showToast(msg, type){
    type = type || 'success';
    const el = document.createElement('div');
    el.className = 'toast';
    const iconSvg = type === 'error'
      ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
    el.innerHTML = '<span class="toast-icon">' + iconSvg + '</span><span>' + msg + '</span>';
    toastWrap.appendChild(el);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('show')));
    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => el.parentNode && el.parentNode.removeChild(el), 340);
    }, 2800);
  }

  function copyText(text){
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).then(() => true).catch(() => fallback(text));
    }
    return Promise.resolve(fallback(text));
  }
  function fallback(text){
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly','');
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch(e) { return false; }
  }

  function copyIP(btn, value){
    const isPort = value === '25585';
    const label = isPort ? 'Puerto' : (value.indexOf('bedrock') !== -1 ? 'IP Bedrock' : 'IP Java');
    copyText(value).then(ok => {
      if (ok) {
        showToast(label + ' copiado: ' + value, 'success');
        if (btn) {
          btn.classList.add('copied');
          const icon = btn.querySelector('svg');
          if (icon) {
            const prev = icon.innerHTML;
            icon.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
            setTimeout(() => { icon.innerHTML = prev; btn.classList.remove('copied'); }, 1600);
          }
        }
      } else {
        showToast('No se pudo copiar. Valor: ' + value, 'error');
      }
    });
  }

  window.copyIP = copyIP;
  window.toggleMenu = toggleMenu;
})();
</script>
</body>
</html>
