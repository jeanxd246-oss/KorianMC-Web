<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>KorianMC - Network de Minecraft · Java & Bedrock</title>
<meta name="description" content="KorianMC es una network de Minecraft con identidad japonesa. Studio oficial con plugins, mapas y setups." />
<link rel="icon" type="image/png" href="https://i.imgur.com/gr2YMP6.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --red:#D71920;
  --red-light:#FF2A32;
  --red-dark:#A00E13;
  --red-soft:rgba(215,25,32,.14);
  --red-line:rgba(215,25,32,.34);
  --purple:#7B2FBE;
  --cyan:#00D4FF;
  --pink:#FF2E88;
  --green:#22c55e;
  --black:#090909;
  --bg:#08080A;
  --surface:#101013;
  --surface-2:#151519;
  --surface-3:#1C1C21;
  --border:rgba(255,255,255,.08);
  --border-strong:rgba(255,255,255,.14);
  --text:#EDEDEF;
  --text-dim:#9A9AA3;
  --text-mute:#5E5E68;
  --font-display:'Outfit',system-ui,-apple-system,sans-serif;
  --font-brand:'Space Grotesk',system-ui,sans-serif;
  --font-body:'Inter',system-ui,-apple-system,sans-serif;
  --ease:cubic-bezier(.22,1,.36,1);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --nav-h:70px;
  --radius:14px;
  --radius-lg:18px;
  --radius-xl:24px;
  --radius-2xl:32px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;}
body{
  font-family:var(--font-body);background:var(--bg);color:var(--text);
  line-height:1.6;overflow-x:hidden;min-height:100vh;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  letter-spacing:-.01em;
}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;border:none;background:none;cursor:pointer;color:inherit;font-weight:inherit;}
img{max-width:100%;display:block;}
svg{display:block;flex-shrink:0;}
::selection{background:var(--red);color:#fff;}
::-webkit-scrollbar{width:10px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:#24242A;border-radius:10px;}
::-webkit-scrollbar-thumb:hover{background:#34343C;}

/* ========== MESH BG RGB ========== */
body::before{
  content:'';position:fixed;inset:-15%;z-index:-1;
  background:
    radial-gradient(circle at 12% 20%, rgba(215,25,32,.14), transparent 42%),
    radial-gradient(circle at 85% 15%, rgba(123,47,190,.12), transparent 42%),
    radial-gradient(circle at 20% 85%, rgba(0,180,220,.10), transparent 42%),
    radial-gradient(circle at 90% 80%, rgba(255,46,136,.08), transparent 42%);
  animation:meshFloat 32s ease-in-out infinite;
  pointer-events:none;will-change:transform;
}
@keyframes meshFloat{
  0%,100%{transform:translate(0,0) scale(1);}
  33%{transform:translate(2%,-1.5%) scale(1.04);}
  66%{transform:translate(-1.5%,2%) scale(.98);}
}

.container{width:100%;max-width:1240px;margin:0 auto;padding:0 28px;position:relative;}
.section{padding:120px 0;position:relative;}
.section-sm{padding:80px 0;position:relative;}

/* ========== NAVBAR ========== */
.navbar{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  height:var(--nav-h);display:flex;align-items:center;padding:0 28px;
  background:rgba(8,8,10,.55);
  backdrop-filter:blur(18px) saturate(150%);
  -webkit-backdrop-filter:blur(18px) saturate(150%);
  border-bottom:1px solid transparent;
  transition:background .35s var(--ease), border-color .35s var(--ease);
}
.navbar.scrolled{
  background:rgba(8,8,10,.94);
  border-bottom-color:var(--border);
  box-shadow:0 1px 0 rgba(215,25,32,.08);
}
.nav-inner{width:100%;max-width:1440px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px;}
.nav-brand{display:flex;align-items:center;gap:13px;flex-shrink:0;transition:transform .3s var(--ease);}
.nav-brand:hover{transform:translateY(-1px);}
.nav-brand .brand-logo{
  width:38px;height:38px;object-fit:contain;
  filter:drop-shadow(0 4px 14px rgba(215,25,32,.35));
  transition:filter .3s var(--ease);
}
.nav-brand:hover .brand-logo{filter:drop-shadow(0 4px 22px rgba(215,25,32,.65));}
.nav-brand .brand-fallback{
  display:none;width:38px;height:38px;
  background:linear-gradient(135deg,var(--red),var(--purple),var(--cyan));
  border-radius:10px;align-items:center;justify-content:center;
  font-family:var(--font-brand);font-weight:700;font-size:18px;color:#fff;
}
.nav-brand.no-img .brand-logo{display:none;}
.nav-brand.no-img .brand-fallback{display:flex;}
.nav-brand .brand-name{
  font-family:var(--font-brand);
  font-weight:700;font-size:18px;
  letter-spacing:-.045em;
  background:linear-gradient(135deg,#fff 0%,#D8D8DE 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;white-space:nowrap;position:relative;line-height:1.1;
}
.nav-brand .brand-name em{
  font-style:normal;
  background:linear-gradient(90deg, #FF3B42 0%, #FF2E88 50%, #D71920 100%);
  background-size:200% auto;
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;font-weight:700;letter-spacing:-.05em;
  animation:brandShimmer 6s ease-in-out infinite;
}
@keyframes brandShimmer{0%,100%{background-position:0% center;}50%{background-position:100% center;}}
.nav-links{display:flex;align-items:center;gap:2px;}
.nav-link{
  position:relative;padding:9px 15px;
  font-family:var(--font-body);font-size:13.5px;font-weight:600;
  color:var(--text-dim);border-radius:9px;
  transition:color .22s var(--ease), background .22s var(--ease);
  letter-spacing:-.005em;white-space:nowrap;
}
.nav-link:hover{color:#fff;background:rgba(255,255,255,.035);}
.nav-link.active{color:#fff;background:rgba(255,255,255,.05);}
.nav-link.active::after{
  content:'';position:absolute;bottom:-3px;left:50%;
  transform:translateX(-50%);
  width:16px;height:2px;border-radius:2px;
  background:linear-gradient(90deg,var(--red),var(--purple),var(--cyan));
  box-shadow:0 0 12px rgba(215,25,32,.6);
}
.nav-toggle{
  display:none;flex-direction:column;justify-content:center;gap:5px;
  width:42px;height:42px;padding:11px;border-radius:9px;
  transition:background .2s;
}
.nav-toggle:hover{background:rgba(255,255,255,.06);}
.nav-toggle span{
  display:block;height:1.5px;width:100%;background:#fff;border-radius:2px;
  transition:transform .38s var(--ease), opacity .22s var(--ease);
  transform-origin:center;
}
.nav-toggle.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
.nav-toggle.open span:nth-child(2){opacity:0;}
.nav-toggle.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}
.mobile-menu{
  position:fixed;inset:0;z-index:999;
  background:rgba(8,8,10,.97);
  backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
  padding:calc(var(--nav-h) + 32px) 24px 40px;
  opacity:0;visibility:hidden;
  transition:opacity .32s var(--ease), visibility .32s var(--ease);
  overflow-y:auto;
}
.mobile-menu.open{opacity:1;visibility:visible;}
.mobile-menu-inner{max-width:440px;margin:0 auto;display:flex;flex-direction:column;gap:4px;}
.mobile-link{
  display:flex;align-items:center;justify-content:space-between;
  padding:17px 20px;font-family:var(--font-display);
  font-size:17px;font-weight:600;color:var(--text-dim);
  border-radius:11px;border:1px solid transparent;
  transition:all .25s var(--ease);
  transform:translateX(-14px);opacity:0;
}
.mobile-menu.open .mobile-link{transform:translateX(0);opacity:1;}
.mobile-menu.open .mobile-link:nth-child(1){transition-delay:.05s;}
.mobile-menu.open .mobile-link:nth-child(2){transition-delay:.08s;}
.mobile-menu.open .mobile-link:nth-child(3){transition-delay:.11s;}
.mobile-menu.open .mobile-link:nth-child(4){transition-delay:.14s;}
.mobile-menu.open .mobile-link:nth-child(5){transition-delay:.17s;}
.mobile-menu.open .mobile-link:nth-child(6){transition-delay:.20s;}
.mobile-link:hover{color:#fff;background:rgba(255,255,255,.04);}
.mobile-link.active{color:#fff;background:rgba(255,255,255,.05);border-color:var(--border);}
.mobile-link.active svg{color:var(--red);}
.mobile-link svg{width:16px;height:16px;color:var(--text-mute);}
.mobile-footer{
  margin-top:28px;padding-top:24px;border-top:1px solid var(--border);
  font-family:var(--font-body);font-size:11px;color:var(--text-mute);
  letter-spacing:.14em;text-align:center;
}

/* ========== BUTTONS ========== */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:14px 24px;
  font-family:var(--font-body);font-size:13.5px;font-weight:700;letter-spacing:-.005em;
  border-radius:11px;transition:all .25s var(--ease);
  position:relative;white-space:nowrap;border:1px solid transparent;overflow:hidden;
}
.btn svg{width:15px;height:15px;}
.btn-primary{
  background:linear-gradient(135deg,var(--red) 0%,var(--red-dark) 100%);
  color:#fff;
  box-shadow:0 8px 24px -8px rgba(215,25,32,.6),inset 0 1px 0 rgba(255,255,255,.12);
}
.btn-primary::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg, #FF3B42 0%, #FF2E88 50%, var(--red) 100%);
  background-size:200% auto;
  animation:btnShift 4s ease-in-out infinite;
  opacity:0;transition:opacity .3s var(--ease);
}
@keyframes btnShift{0%,100%{background-position:0% center;}50%{background-position:100% center;}}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px -8px rgba(215,25,32,.7);}
.btn-primary:hover::before{opacity:1;}
.btn-primary > *{position:relative;z-index:1;}
.btn-primary:active{transform:translateY(0);}
.btn-outline{
  background:rgba(255,255,255,.03);color:#fff;border-color:var(--border-strong);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
}
.btn-outline:hover{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.24);transform:translateY(-2px);}
.btn-sm{padding:11px 18px;font-size:12.5px;border-radius:9px;}
.btn-block{width:100%;}
.btn-discord{
  background:#5865F2;color:#fff;
  box-shadow:0 6px 20px -6px rgba(88,101,242,.5),inset 0 1px 0 rgba(255,255,255,.12);
}
.btn-discord:hover{background:#4752C4;transform:translateY(-2px);box-shadow:0 10px 28px -6px rgba(88,101,242,.6);}

/* ========== TOAST ========== */
.toast-wrap{
  position:fixed;bottom:26px;left:50%;transform:translateX(-50%);z-index:10000;
  display:flex;flex-direction:column;gap:8px;align-items:center;
  pointer-events:none;padding:0 16px;
}
.toast{
  display:flex;align-items:center;gap:11px;padding:13px 20px;
  background:var(--surface-3);border:1px solid var(--border-strong);border-radius:12px;
  color:#fff;font-size:13px;font-weight:500;
  box-shadow:0 20px 48px rgba(0,0,0,.7);
  opacity:0;transform:translateY(14px) scale(.96);
  transition:opacity .3s var(--ease), transform .3s var(--ease);
  pointer-events:auto;max-width:calc(100vw - 32px);
  letter-spacing:-.005em;font-family:var(--font-body);
}
.toast.show{opacity:1;transform:translateY(0) scale(1);}
.toast .toast-icon{
  display:flex;align-items:center;justify-content:center;
  width:24px;height:24px;border-radius:7px;
  background:var(--red-soft);color:var(--red);flex-shrink:0;
}
.toast .toast-icon svg{width:13px;height:13px;}

/* ========== PAGE ROUTER ========== */
main{position:relative;min-height:100vh;}
.page{display:none;}
.page.active{display:block;animation:pageIn .5s var(--ease-out);}
@keyframes pageIn{from{opacity:0;transform:translateY(14px) scale(.99);}to{opacity:1;transform:translateY(0) scale(1);}}

/* ========== REVEAL ========== */
.reveal{opacity:0;transition:opacity .9s var(--ease-out), transform .9s var(--ease-out);will-change:opacity, transform;}
.reveal-up{transform:translateY(36px);}
.reveal-left{transform:translateX(-36px);}
.reveal-right{transform:translateX(36px);}
.reveal-scale{transform:scale(.94);}
.reveal.visible{opacity:1;transform:none;}

/* ========== SECTION HEADER ========== */
.sec-head{max-width:680px;margin-bottom:64px;}
.sec-head.center{text-align:center;margin-left:auto;margin-right:auto;}
.sec-label{
  display:inline-flex;align-items:center;
  font-family:var(--font-body);font-size:11px;font-weight:700;letter-spacing:.18em;
  color:var(--red);text-transform:uppercase;margin-bottom:18px;
}
.sec-title{
  font-family:var(--font-display);
  font-size:clamp(2rem,4.2vw,3.2rem);font-weight:800;
  letter-spacing:-.035em;line-height:1.05;color:#fff;margin-bottom:16px;
}
.sec-title .accent{color:var(--red);}
.sec-title .accent-rgb{
  background:linear-gradient(90deg, #FF3B42 0%, #FF2E88 25%, #7B2FBE 50%, #00D4FF 75%, #FF3B42 100%);
  background-size:300% auto;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:rgbSlide 8s linear infinite;display:inline-block;
  filter:drop-shadow(0 0 20px rgba(255,46,136,.25));
}
@keyframes rgbSlide{0%{background-position:0% center;}100%{background-position:300% center;}}
.sec-desc{
  font-family:var(--font-body);font-size:15.5px;
  color:var(--text-dim);line-height:1.7;letter-spacing:-.005em;
}

/* ========== HERO ========== */
.hero{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  padding:calc(var(--nav-h) + 48px) 24px 72px;
  position:relative;overflow:hidden;isolation:isolate;
}
.hero-bg-layer{
  position:absolute;inset:0;z-index:-4;
  background-size:cover;background-position:center 30%;
  background-image:url('https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1920&q=80&auto=format&fit=crop');
  transform:scale(1.08);
  animation:heroBgDrift 26s ease-in-out infinite alternate;
  filter:saturate(.85) brightness(.55);
}
@keyframes heroBgDrift{from{transform:scale(1.08) translate(0,0);}to{transform:scale(1.14) translate(-1.5%,-1%);}}
.hero-overlay-1{
  position:absolute;inset:0;z-index:-3;
  background:
    radial-gradient(ellipse 70% 60% at 50% 40%, rgba(8,8,10,.35) 0%, rgba(8,8,10,.75) 60%, rgba(8,8,10,.96) 100%),
    linear-gradient(180deg, rgba(8,8,10,.55) 0%, rgba(8,8,10,.15) 30%, rgba(8,8,10,.5) 75%, rgba(8,8,10,.98) 100%);
}
.hero-blobs{position:absolute;inset:0;z-index:-2;overflow:hidden;pointer-events:none;}
.hero-blob{position:absolute;border-radius:50%;will-change:transform;transform:translateZ(0);}
.hero-blob.blob-red{
  width:70vmax;height:70vmax;top:-25%;left:-20%;
  background:radial-gradient(circle, rgba(215,25,32,.28) 0%, rgba(215,25,32,.06) 30%, transparent 60%);
  animation:blobFloat1 24s ease-in-out infinite;
}
.hero-blob.blob-purple{
  width:60vmax;height:60vmax;bottom:-30%;right:-15%;
  background:radial-gradient(circle, rgba(123,47,190,.20) 0%, rgba(123,47,190,.04) 30%, transparent 60%);
  animation:blobFloat2 30s ease-in-out infinite;
}
.hero-blob.blob-cyan{
  width:55vmax;height:55vmax;top:25%;right:-25%;
  background:radial-gradient(circle, rgba(0,180,220,.16) 0%, rgba(0,180,220,.03) 30%, transparent 60%);
  animation:blobFloat3 34s ease-in-out infinite;
}
.hero-blob.blob-pink{
  width:50vmax;height:50vmax;top:60%;left:-15%;
  background:radial-gradient(circle, rgba(255,46,136,.14) 0%, rgba(255,46,136,.02) 30%, transparent 60%);
  animation:blobFloat1 28s ease-in-out infinite reverse;
}
@keyframes blobFloat1{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(6vw,4vh) scale(1.05);}}
@keyframes blobFloat2{0%,100%{transform:translate(0,0) scale(1.05);}50%{transform:translate(-5vw,-3vh) scale(.98);}}
@keyframes blobFloat3{0%,100%{transform:translate(0,0) scale(.95);}50%{transform:translate(-4vw,5vh) scale(1.02);}}
.hero-overlay-2{
  position:absolute;inset:0;z-index:-1;
  background:
    radial-gradient(circle at 20% 80%, rgba(215,25,32,.16), transparent 45%),
    radial-gradient(circle at 80% 20%, rgba(123,47,190,.12), transparent 45%),
    radial-gradient(circle at 50% 100%, rgba(255,46,136,.10), transparent 45%);
  pointer-events:none;
}
.hero-particles{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;}
.petal{
  position:absolute;width:8px;height:8px;
  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.5), rgba(215,25,32,.25));
  border-radius:50% 50% 50% 0;opacity:.35;
  animation:petalFall linear infinite;
}
.petal:nth-child(1){left:12%;animation-duration:18s;animation-delay:0s;}
.petal:nth-child(2){left:28%;animation-duration:22s;animation-delay:-4s;width:6px;height:6px;}
.petal:nth-child(3){left:45%;animation-duration:20s;animation-delay:-8s;}
.petal:nth-child(4){left:62%;animation-duration:24s;animation-delay:-2s;width:7px;height:7px;}
.petal:nth-child(5){left:78%;animation-duration:19s;animation-delay:-6s;}
.petal:nth-child(6){left:88%;animation-duration:21s;animation-delay:-10s;width:5px;height:5px;}
@keyframes petalFall{
  0%{transform:translateY(-30px) rotate(0);opacity:0;}
  10%{opacity:.4;}
  90%{opacity:.3;}
  100%{transform:translateY(105vh) rotate(360deg);opacity:0;}
}
.hero-inner{position:relative;z-index:2;text-align:center;max-width:780px;}
.hero-logo{display:flex;justify-content:center;margin-bottom:26px;}
.hero-logo img{
  height:96px;width:auto;max-width:240px;object-fit:contain;
  filter:drop-shadow(0 16px 44px rgba(0,0,0,.8)) drop-shadow(0 0 30px rgba(215,25,32,.3));
  animation:heroLogoIn 1s var(--ease-out) both;
}
.hero-logo .fallback{
  display:none;width:88px;height:88px;
  background:linear-gradient(135deg,var(--red),var(--purple),var(--cyan));
  border-radius:22px;align-items:center;justify-content:center;
  font-family:var(--font-brand);font-weight:700;font-size:38px;color:#fff;
}
.hero-logo.no-img img{display:none;}
.hero-logo.no-img .fallback{display:flex;}
@keyframes heroLogoIn{from{opacity:0;transform:translateY(-14px) scale(.9);}to{opacity:1;transform:translateY(0) scale(1);}}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  padding:7px 16px;
  font-family:var(--font-body);font-size:11.5px;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;color:#fff;
  background:rgba(8,8,10,.5);border:1px solid rgba(255,255,255,.16);
  border-radius:100px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  margin-bottom:24px;animation:heroItemIn .8s var(--ease-out) .15s both;
}
.hero-eyebrow .dot{
  width:6px;height:6px;border-radius:50%;background:var(--red);
  box-shadow:0 0 10px var(--red),0 0 20px rgba(215,25,32,.5);
  animation:pulseDot 2.4s ease-in-out infinite;
}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(.75);}}
.hero-title{
  font-family:var(--font-display);
  font-size:clamp(3rem,8vw,6rem);font-weight:900;
  letter-spacing:-.055em;line-height:.92;color:#fff;margin-bottom:24px;
  text-shadow:0 8px 40px rgba(0,0,0,.5);
  animation:heroItemIn .8s var(--ease-out) .25s both;
}
.hero-accent-rgb{
  background:linear-gradient(90deg, #FF3B42 0%, #FF2E88 20%, #7B2FBE 40%, #00D4FF 60%, #FF2E88 80%, #FF3B42 100%);
  background-size:300% auto;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:rgbSlide 6s linear infinite;
  display:inline-block;filter:drop-shadow(0 0 30px rgba(255,46,136,.4));
  will-change:background-position;
}
.hero-desc{
  font-family:var(--font-body);font-size:clamp(15px,1.6vw,17px);
  color:rgba(237,237,239,.85);line-height:1.65;
  max-width:520px;margin:0 auto 36px;letter-spacing:-.005em;
  animation:heroItemIn .8s var(--ease-out) .35s both;
}
.hero-actions{
  display:flex;gap:12px;justify-content:center;flex-wrap:wrap;
  animation:heroItemIn .8s var(--ease-out) .45s both;margin-bottom:44px;
}
@keyframes heroItemIn{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

/* ========== CONNECTION CARDS ========== */
.conn-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:14px;
  max-width:720px;margin:0 auto;
  animation:heroItemIn .8s var(--ease-out) .55s both;
  align-items:stretch;
}
.conn-card{
  padding:16px 18px 14px;
  background:rgba(16,16,19,.88);
  border-radius:15px;
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  text-align:left;transition:all .3s var(--ease);
  position:relative;overflow:hidden;
  display:flex;flex-direction:column;
  isolation:isolate;
}
.conn-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, #FF3B42, #FF2E88, #7B2FBE, #00D4FF, #FF3B42);
  background-size:300% 300%;
  animation:borderShift 8s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.5;transition:opacity .35s var(--ease);
  pointer-events:none;will-change:background-position;z-index:1;
}
.conn-card::after{
  content:'';position:absolute;inset:1px;border-radius:14px;
  background:rgba(16,16,19,.96);
  z-index:-1;
  pointer-events:none;
}
.conn-card:hover::before{opacity:1;}
.conn-card:hover{
  transform:translateY(-2px);
  box-shadow:0 20px 40px -22px rgba(0,0,0,.8),0 0 30px -10px rgba(255,46,136,.25);
}
.conn-card > *{position:relative;z-index:2;}
@keyframes borderShift{0%,100%{background-position:0% 50%;}50%{background-position:100% 50%;}}
.conn-label{
  display:flex;align-items:center;gap:8px;
  font-family:var(--font-body);font-size:10px;font-weight:700;
  letter-spacing:.16em;text-transform:uppercase;color:var(--text-mute);
  margin-bottom:10px;
}
.conn-label .edition-tag{
  color:var(--red);padding:2px 7px;background:var(--red-soft);
  border:1px solid var(--red-line);border-radius:4px;
  font-size:9.5px;letter-spacing:.1em;
}
.conn-field{display:flex;flex-direction:column;gap:4px;}
.conn-field + .conn-field{
  margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06);
}
.conn-field-label{
  font-family:var(--font-body);font-size:9px;font-weight:700;
  letter-spacing:.16em;text-transform:uppercase;color:var(--text-mute);
}
.conn-field-value{
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  font-family:'SF Mono',ui-monospace,Menlo,monospace;
  font-size:13px;color:#fff;font-weight:500;line-height:1.3;
}
.conn-field-value .ip-text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:.01em;}
.conn-field-value .port-text{
  font-family:'SF Mono',ui-monospace,Menlo,monospace;
  color:#fff;font-weight:500;letter-spacing:.04em;
}
.conn-copy{
  display:flex;align-items:center;justify-content:center;
  width:26px;height:26px;border-radius:6px;
  color:var(--text-dim);transition:all .22s var(--ease);flex-shrink:0;
}
.conn-copy:hover{background:rgba(215,25,32,.15);color:var(--red);}
.conn-copy.copied{background:var(--red-soft);color:var(--red);}
.conn-copy svg{width:13px;height:13px;}
.conn-status{
  margin-top:auto;padding-top:10px;
  border-top:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;gap:7px;
  font-family:var(--font-body);font-size:10px;font-weight:600;
  color:var(--text-dim);letter-spacing:.1em;text-transform:uppercase;
}
.status-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--green);
  box-shadow:0 0 10px var(--green),0 0 4px var(--green);
  animation:statusPulse 2s ease-in-out infinite;
  flex-shrink:0;
}
@keyframes statusPulse{
  0%,100%{opacity:1;transform:scale(1);}
  50%{opacity:.6;transform:scale(.85);}
}

/* ========== SECTIONS ========== */
.section-about{
  position:relative;
  background:linear-gradient(180deg,transparent 0%,rgba(10,10,13,.85) 50%,transparent 100%);
  overflow:hidden;
}
.section-about::before{
  content:'';position:absolute;inset:0;
  background-image:url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=75&auto=format&fit=crop');
  background-size:cover;background-position:center;opacity:.08;
  filter:grayscale(.4) brightness(.4);pointer-events:none;
}
.section-about-orb{
  position:absolute;top:20%;right:-10%;
  width:500px;height:500px;border-radius:50%;
  background:radial-gradient(circle, rgba(215,25,32,.14) 0%, transparent 70%);
  pointer-events:none;filter:blur(60px);
  animation:orbFloat 18s ease-in-out infinite;z-index:1;
}
.section-about-orb.orb-2{
  top:auto;bottom:10%;left:-15%;right:auto;
  width:400px;height:400px;
  background:radial-gradient(circle, rgba(123,47,190,.12) 0%, transparent 70%);
  animation-delay:-8s;
}
.section-about-orb.orb-3{
  top:50%;left:30%;right:auto;bottom:auto;
  width:300px;height:300px;
  background:radial-gradient(circle, rgba(255,46,136,.08) 0%, transparent 70%);
  animation-delay:-4s;
}
@keyframes orbFloat{
  0%,100%{transform:translate(0,0) scale(1);}
  50%{transform:translate(30px,-20px) scale(1.1);}
}
.section-community{
  position:relative;
  background:linear-gradient(180deg,transparent 0%,rgba(10,10,13,.5) 50%,transparent 100%);
  overflow:hidden;
}
.section-community::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(circle at 10% 30%, rgba(88,101,242,.10), transparent 40%),
    radial-gradient(circle at 90% 70%, rgba(215,25,32,.10), transparent 40%);
  pointer-events:none;
}
.section-team{position:relative;overflow:hidden;}
.section-team::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 50% 50% at 50% 40%, rgba(215,25,32,.10), transparent 70%),
    radial-gradient(ellipse 40% 40% at 20% 80%, rgba(123,47,190,.08), transparent 70%),
    radial-gradient(ellipse 40% 40% at 80% 20%, rgba(255,46,136,.06), transparent 70%);
  pointer-events:none;
}
.section-studio{position:relative;overflow:hidden;}
.section-studio::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 50% 40% at 50% 15%, rgba(215,25,32,.12), transparent 70%),
    radial-gradient(ellipse 40% 40% at 85% 75%, rgba(139,92,246,.10), transparent 70%),
    radial-gradient(ellipse 40% 40% at 15% 60%, rgba(0,180,220,.06), transparent 70%);
  pointer-events:none;
}

/* ========== ABOUT ========== */
.about-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:72px;align-items:center;position:relative;z-index:2;}
.about-body{position:relative;}
.about-body p{
  font-family:var(--font-body);font-size:15.5px;line-height:1.8;
  color:var(--text-dim);margin-bottom:18px;letter-spacing:-.005em;
}
.about-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:36px;}
.stat{
  padding:24px 18px;
  background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.008));
  border:1px solid var(--border);border-radius:var(--radius);text-align:center;
  transition:all .35s var(--ease);position:relative;overflow:hidden;
}
.stat::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(215,25,32,.12),transparent);
  opacity:0;transition:opacity .35s var(--ease);
}
.stat:hover{
  border-color:rgba(255,46,136,.3);transform:translateY(-4px);
  box-shadow:0 20px 40px -20px rgba(255,46,136,.3);
}
.stat:hover::before{opacity:1;}
.stat-num{
  font-family:var(--font-display);font-size:26px;font-weight:800;color:#fff;
  letter-spacing:-.03em;line-height:1;margin-bottom:8px;position:relative;
}
.stat-num .accent{color:var(--red);}
.stat-lbl{
  font-family:var(--font-body);font-size:10.5px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;color:var(--text-mute);position:relative;
}
.about-visual{
  position:relative;aspect-ratio:4/3;border-radius:var(--radius-2xl);
  background:var(--surface);overflow:hidden;
  box-shadow:0 30px 80px -30px rgba(0,0,0,.8),0 0 60px -20px rgba(215,25,32,.2);
  padding:1.5px;
}
.about-visual::before{
  content:'';position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(135deg, #FF3B42, #FF2E88, #7B2FBE, #00D4FF, #FF3B42);
  background-size:300% 300%;
  animation:borderShift 12s ease infinite;
}
.about-visual::after{
  content:'';position:absolute;inset:1.5px;border-radius:calc(var(--radius-2xl) - 2px);
  background:linear-gradient(180deg,transparent 50%,rgba(8,8,10,.55) 100%);
  pointer-events:none;z-index:2;
}
.about-img{
  position:absolute;inset:1.5px;border-radius:calc(var(--radius-2xl) - 2px);
  width:calc(100% - 3px);height:calc(100% - 3px);
  object-fit:cover;display:block;z-index:1;
  transition:transform 1s var(--ease-out);will-change:transform;
}
.about-visual:hover .about-img{transform:scale(1.05);}
.about-img-fallback{
  display:none;width:100%;height:100%;align-items:center;justify-content:center;
  background:radial-gradient(circle at center, rgba(215,25,32,.15), transparent 70%),
    linear-gradient(135deg,var(--surface),var(--bg));
  color:var(--red);border-radius:inherit;
}
.about-img-fallback svg{width:25%;height:auto;opacity:.6;}
.about-visual.no-img .about-img{display:none;}
.about-visual.no-img .about-img-fallback{display:flex;}

/* ========== STUDIO — HOME PREVIEW ========== */
.studio-preview{
  display:grid;grid-template-columns:repeat(5,1fr);gap:14px;
  max-width:1000px;margin:0 auto 40px;
}
.tier-mini{
  padding:22px 14px;
  background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.005));
  border:1px solid var(--border);border-radius:14px;text-align:center;
  transition:all .3s var(--ease);
  position:relative;overflow:hidden;
  isolation:isolate;
}
.tier-mini::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, var(--tier-color), transparent 60%, var(--tier-color));
  background-size:200% 200%;
  animation:borderShift 10s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.35;transition:opacity .3s var(--ease);
  pointer-events:none;
}
.tier-mini::after{
  content:'';position:absolute;inset:1px;border-radius:13px;
  background:rgba(16,16,19,.94);
  z-index:-1;pointer-events:none;
}
.tier-mini:hover{
  transform:translateY(-4px);
  box-shadow:0 16px 30px -18px rgba(0,0,0,.6),0 0 24px -10px var(--tier-color);
}
.tier-mini:hover::before{opacity:.9;}
.tier-mini > *{position:relative;z-index:1;}
.tier-mini-icon{
  width:44px;height:44px;margin:0 auto 12px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;
  background:color-mix(in srgb, var(--tier-color) 14%, transparent);
  border:1px solid color-mix(in srgb, var(--tier-color) 35%, transparent);
  color:var(--tier-color);
  transition:transform .3s var(--ease);
  box-shadow:0 6px 18px -8px var(--tier-color);
}
.tier-mini:hover .tier-mini-icon{transform:scale(1.08);}
.tier-mini-icon svg{width:22px;height:22px;}
.tier-mini-name{
  font-family:var(--font-display);font-size:14.5px;font-weight:800;
  color:#fff;margin-bottom:3px;letter-spacing:-.01em;
}
.tier-mini-req{
  font-family:var(--font-body);font-size:9.5px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  color:var(--text-mute);
}

.tier-copper{--tier-color:#D68B4A;}
.tier-carbon{--tier-color:#8B8B95;}
.tier-iron{--tier-color:#B8BCC6;}
.tier-diamond{--tier-color:#4AEDD9;}
.tier-netherite{--tier-color:#8B5CF6;}

/* ========== STUDIO — PAGE ========== */
.studio-intro{max-width:720px;margin:0 auto 64px;text-align:center;}
.studio-intro p{
  font-family:var(--font-body);font-size:16px;line-height:1.75;
  color:var(--text-dim);letter-spacing:-.005em;
}
.studio-intro p + p{margin-top:14px;}

.studio-features{
  display:grid;grid-template-columns:repeat(4,1fr);gap:16px;
  margin-bottom:80px;
}
.feature-card{
  padding:28px 24px;
  background:linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.005));
  border:1px solid var(--border);border-radius:16px;
  transition:all .35s var(--ease);
  position:relative;overflow:hidden;
  isolation:isolate;
}
.feature-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, rgba(215,25,32,.5), rgba(123,47,190,.4), rgba(0,180,220,.3), rgba(215,25,32,.5));
  background-size:300% 300%;
  animation:borderShift 12s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .35s var(--ease);
  pointer-events:none;will-change:background-position;
}
.feature-card:hover::before{opacity:1;}
.feature-card:hover{
  transform:translateY(-3px);
  box-shadow:0 20px 40px -25px rgba(0,0,0,.6),0 0 30px -15px rgba(255,46,136,.2);
}
.feature-card > *{position:relative;z-index:1;}
.feature-icon{
  width:44px;height:44px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.04);
  border:1px solid var(--border);
  color:#fff;margin-bottom:18px;
  transition:all .35s var(--ease);
}
.feature-card:hover .feature-icon{
  background:linear-gradient(135deg, rgba(255,46,136,.2), rgba(123,47,190,.15));
  border-color:rgba(255,46,136,.4);
  color:#FF2E88;
  box-shadow:0 8px 20px -8px rgba(255,46,136,.4);
}
.feature-icon svg{width:20px;height:20px;}
.feature-title{
  font-family:var(--font-display);font-size:15px;font-weight:700;
  color:#fff;margin-bottom:6px;letter-spacing:-.01em;
}
.feature-desc{
  font-family:var(--font-body);font-size:12.5px;line-height:1.6;
  color:var(--text-dim);letter-spacing:-.005em;
}

.studio-subtitle{text-align:center;margin-bottom:40px;}
.studio-subtitle h3{
  font-family:var(--font-display);font-size:clamp(1.4rem,2.5vw,1.8rem);
  font-weight:800;letter-spacing:-.02em;color:#fff;margin-bottom:10px;
}
.studio-subtitle p{
  font-family:var(--font-body);font-size:14.5px;color:var(--text-dim);
  max-width:520px;margin:0 auto;line-height:1.65;
}

.studio-tiers{
  display:grid;grid-template-columns:repeat(4,1fr);gap:16px;
  margin-bottom:24px;
}
.tier-card{
  position:relative;padding:32px 26px;
  background:linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.005));
  border-radius:18px;
  transition:all .4s var(--ease);overflow:hidden;
  display:flex;flex-direction:column;
  isolation:isolate;
}
.tier-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, var(--tier-color), transparent 40%, var(--tier-color));
  background-size:300% 300%;
  animation:borderShift 10s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.4;transition:opacity .4s var(--ease);
  pointer-events:none;will-change:background-position;
}
.tier-card::after{
  content:'';position:absolute;inset:1px;border-radius:17px;
  background:linear-gradient(180deg, rgba(16,16,20,.96), rgba(10,10,14,.99));
  z-index:-1;pointer-events:none;
}
.tier-card:hover{
  transform:translateY(-4px);
  box-shadow:0 24px 50px -25px rgba(0,0,0,.75),0 0 40px -15px var(--tier-color);
}
.tier-card:hover::before{opacity:1;}
.tier-card > *{position:relative;z-index:1;}
.tier-card .tier-icon{
  width:52px;height:52px;margin-bottom:18px;border-radius:13px;
  display:flex;align-items:center;justify-content:center;
  background:color-mix(in srgb, var(--tier-color) 15%, transparent);
  border:1px solid color-mix(in srgb, var(--tier-color) 35%, transparent);
  color:var(--tier-color);
  transition:transform .4s var(--ease);
  box-shadow:0 8px 20px -8px var(--tier-color);
}
.tier-card:hover .tier-icon{transform:scale(1.08) rotate(-3deg);}
.tier-card .tier-icon svg{width:26px;height:26px;}
.tier-card .tier-name{
  font-family:var(--font-display);font-size:20px;font-weight:800;
  color:#fff;margin-bottom:6px;letter-spacing:-.02em;
}
.tier-card .tier-req{
  font-family:var(--font-body);font-size:10.5px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;
  color:var(--tier-color);margin-bottom:20px;
  text-shadow:0 0 12px color-mix(in srgb, var(--tier-color) 50%, transparent);
}
.tier-benefits{list-style:none;flex:1;}
.tier-benefits li{
  display:flex;align-items:flex-start;gap:8px;
  font-family:var(--font-body);font-size:13px;line-height:1.55;
  color:var(--text-dim);padding:7px 0;
  border-bottom:1px solid rgba(255,255,255,.04);
}
.tier-benefits li:last-child{border-bottom:none;}
.tier-benefits li::before{
  content:'✓';color:var(--tier-color);font-weight:800;font-size:11px;
  flex-shrink:0;margin-top:2px;
}

/* Netherite featured */
.tier-netherite-featured{
  grid-column:1 / -1;
  display:grid;grid-template-columns:1fr 320px;align-items:center;gap:56px;
  padding:52px 52px;
  margin-top:8px;
}
.tier-netherite-featured::before{
  background:conic-gradient(from 0deg, transparent 0deg, rgba(139,92,246,.7) 60deg, rgba(255,46,136,.6) 120deg, transparent 180deg, rgba(0,180,220,.6) 240deg, rgba(139,92,246,.7) 300deg, transparent 360deg);
  background-size:auto;
  animation:ctaSpin 12s linear infinite;
  opacity:.6;
}
.tier-netherite-featured::after{
  background:
    radial-gradient(ellipse 50% 60% at 0% 0%, rgba(139,92,246,.14), transparent 60%),
    radial-gradient(ellipse 40% 50% at 100% 100%, rgba(255,46,136,.10), transparent 60%),
    linear-gradient(180deg, rgba(16,16,20,.97), rgba(10,10,14,.99));
}
.tier-netherite-featured:hover::before{opacity:1;}
.tier-netherite-featured:hover{
  box-shadow:0 30px 70px -30px rgba(0,0,0,.8),0 0 50px -15px rgba(139,92,246,.5);
}
.netherite-content{min-width:0;}
.netherite-badge{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 10px;
  background:linear-gradient(135deg, rgba(139,92,246,.3), rgba(255,46,136,.15));
  border:1px solid rgba(139,92,246,.45);
  border-radius:5px;
  font-family:var(--font-body);font-size:9.5px;font-weight:700;
  letter-spacing:.14em;color:#D4B8FF;margin-bottom:14px;
  box-shadow:0 4px 12px -4px rgba(139,92,246,.4);
}
.netherite-badge .dot{
  width:5px;height:5px;border-radius:50%;background:#D4B8FF;
  box-shadow:0 0 8px #D4B8FF;
  animation:pulseDot 1.8s ease-in-out infinite;
}
.netherite-title{
  font-family:var(--font-display);font-size:clamp(1.7rem,3vw,2.2rem);
  font-weight:800;letter-spacing:-.03em;
  background:linear-gradient(90deg, #fff 0%, #D4B8FF 50%, #fff 100%);
  background-size:200% auto;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:rgbSlide 8s linear infinite;
  line-height:1.1;margin-bottom:10px;
}
.netherite-desc{
  font-family:var(--font-body);font-size:14.5px;line-height:1.7;
  color:var(--text-dim);margin-bottom:24px;letter-spacing:-.005em;
  max-width:560px;
}
.netherite-benefits{
  display:grid;grid-template-columns:1fr 1fr;gap:0 24px;
}
.netherite-benefits li{border-bottom:1px solid rgba(255,255,255,.04);}
.netherite-benefits li::before{color:#C4A5FF;}
.netherite-side{
  display:flex;flex-direction:column;align-items:center;
  padding:32px 24px;
  background:linear-gradient(180deg, rgba(139,92,246,.10), rgba(255,46,136,.04));
  border:1px solid rgba(139,92,246,.3);
  border-radius:16px;
  text-align:center;
  position:relative;overflow:hidden;
}
.netherite-side::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 50% 0%, rgba(139,92,246,.20), transparent 60%);
  pointer-events:none;
}
.netherite-side > *{position:relative;z-index:1;}
.netherite-icon-large{
  width:72px;height:72px;border-radius:18px;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg, rgba(139,92,246,.35), rgba(255,46,136,.2));
  border:1px solid rgba(139,92,246,.5);
  color:#D4B8FF;
  margin-bottom:16px;
  box-shadow:0 12px 30px -12px rgba(139,92,246,.6);
  animation:netheriteGlow 3s ease-in-out infinite;
}
@keyframes netheriteGlow{
  0%,100%{box-shadow:0 12px 30px -12px rgba(139,92,246,.6),0 0 0 0 rgba(139,92,246,.3);}
  50%{box-shadow:0 12px 30px -12px rgba(139,92,246,.8),0 0 0 8px rgba(139,92,246,0);}
}
.netherite-icon-large svg{width:34px;height:34px;}
.netherite-price{
  font-family:var(--font-display);font-size:36px;font-weight:800;
  background:linear-gradient(90deg, #fff 0%, #D4B8FF 50%, #fff 100%);
  background-size:200% auto;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:rgbSlide 8s linear infinite;
  letter-spacing:-.03em;line-height:1;margin-bottom:4px;
}
.netherite-price span{
  font-size:14px;color:var(--text-dim);font-weight:600;
  letter-spacing:0;margin-left:4px;
  -webkit-text-fill-color:var(--text-dim);
}
.netherite-price-label{
  font-family:var(--font-body);font-size:10.5px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;
  color:var(--text-mute);margin-bottom:22px;
}
.netherite-side .btn{width:100%;}

/* Studio Discord CTA */
.studio-discord-cta{
  margin-top:56px;
  padding:44px 40px;
  background:
    radial-gradient(ellipse 60% 80% at 50% 50%, rgba(88,101,242,.10), transparent 70%),
    linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.005));
  border-radius:20px;
  text-align:center;
  position:relative;overflow:hidden;
  isolation:isolate;
}
.studio-discord-cta::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, #5865F2, #7B2FBE, #FF2E88, #5865F2);
  background-size:300% 300%;
  animation:borderShift 10s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.5;transition:opacity .4s var(--ease);
  pointer-events:none;will-change:background-position;
}
.studio-discord-cta:hover::before{opacity:1;}
.studio-discord-cta:hover{
  box-shadow:0 30px 60px -30px rgba(0,0,0,.7),0 0 50px -20px rgba(88,101,242,.4);
}
.studio-discord-cta > *{position:relative;z-index:1;}
.studio-discord-cta-icon{
  width:64px;height:64px;border-radius:16px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(88,101,242,.16);
  border:1px solid rgba(88,101,242,.35);
  color:#5865F2;margin:0 auto 20px;
  box-shadow:0 12px 30px -12px rgba(88,101,242,.5);
  transition:transform .35s var(--ease);
}
.studio-discord-cta:hover .studio-discord-cta-icon{transform:scale(1.05) rotate(-3deg);}
.studio-discord-cta-icon svg{width:32px;height:32px;}
.studio-discord-cta-title{
  font-family:var(--font-display);font-size:clamp(1.4rem,2.5vw,1.8rem);
  font-weight:800;letter-spacing:-.025em;color:#fff;margin-bottom:12px;
}
.studio-discord-cta-desc{
  font-family:var(--font-body);font-size:14.5px;line-height:1.7;
  color:var(--text-dim);max-width:500px;margin:0 auto 28px;letter-spacing:-.005em;
}
.studio-discord-cta .btn{margin:0 auto;}

/* ========== COMMUNITY ========== */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:24px;position:relative;z-index:2;}
.community-card{
  position:relative;padding:42px;
  border-radius:var(--radius-xl);
  transition:all .4s var(--ease);display:flex;flex-direction:column;overflow:hidden;
  isolation:isolate;
}
.community-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, #5865F2, #7B2FBE, #00D4FF, #5865F2);
  background-size:300% 300%;
  animation:borderShift 10s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.5;transition:opacity .4s var(--ease);
  pointer-events:none;will-change:background-position;
}
.community-card.bedrock::before{
  background:linear-gradient(135deg, #D71920, #FF2E88, #7B2FBE, #D71920);
  background-size:300% 300%;
}
.community-card::after{
  content:'';position:absolute;inset:1px;border-radius:calc(var(--radius-xl) - 1px);
  background:
    radial-gradient(circle at 100% 0%, rgba(88,101,242,.10), transparent 50%),
    linear-gradient(180deg, rgba(20,20,24,.96), rgba(12,12,16,.99));
  z-index:-1;pointer-events:none;
}
.community-card.bedrock::after{
  background:
    radial-gradient(circle at 100% 0%, rgba(215,25,32,.10), transparent 50%),
    linear-gradient(180deg, rgba(20,20,24,.96), rgba(12,12,16,.99));
}
.community-card:hover::before{opacity:1;}
.community-card:hover{
  transform:translateY(-4px);
  box-shadow:0 30px 60px -30px rgba(0,0,0,.8),0 0 40px -20px rgba(88,101,242,.3);
}
.community-card.bedrock:hover{
  box-shadow:0 30px 60px -30px rgba(0,0,0,.8),0 0 40px -20px rgba(215,25,32,.35);
}
.community-card > *{position:relative;z-index:1;}
.community-card:hover .community-icon{transform:scale(1.06) rotate(-3deg);}
.community-head{display:flex;align-items:center;gap:18px;margin-bottom:24px;position:relative;}
.community-icon{
  width:56px;height:56px;display:flex;align-items:center;justify-content:center;
  border-radius:14px;
  background:linear-gradient(135deg, rgba(88,101,242,.25), rgba(88,101,242,.10));
  color:#7289DA;
  flex-shrink:0;transition:all .35s var(--ease);border:1px solid rgba(88,101,242,.4);
  box-shadow:0 8px 24px -8px rgba(88,101,242,.5);
}
.community-card.bedrock .community-icon{
  background:linear-gradient(135deg, rgba(215,25,32,.25), rgba(215,25,32,.10));
  color:var(--red-light);border-color:rgba(215,25,32,.4);
  box-shadow:0 8px 24px -8px rgba(215,25,32,.5);
}
.community-icon svg{width:28px;height:28px;}
.community-tag{
  font-family:var(--font-body);font-size:10.5px;font-weight:700;letter-spacing:.16em;
  color:var(--text-mute);text-transform:uppercase;margin-bottom:6px;display:block;
}
.community-title{
  font-family:var(--font-display);font-size:24px;font-weight:800;
  letter-spacing:-.025em;color:#fff;line-height:1.2;
}
.community-desc{
  font-family:var(--font-body);font-size:14.5px;line-height:1.75;
  color:var(--text-dim);margin-bottom:30px;letter-spacing:-.005em;flex:1;position:relative;
}
.community-card .btn{width:100%;position:relative;}

/* ========== TEAM ========== */
.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;max-width:1000px;margin:0 auto;position:relative;z-index:2;}
.team-card{
  position:relative;padding:52px 42px;
  border-radius:26px;overflow:hidden;transition:transform .4s var(--ease);
  box-shadow:0 30px 70px -25px rgba(0,0,0,.7);
  isolation:isolate;
}
.team-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1.5px;
  background:linear-gradient(135deg,#FF3B42 0%,#FF2E88 20%,#7B2FBE 40%,#00D4FF 60%,#7B2FBE 80%,#FF3B42 100%);
  background-size:300% 300%;
  animation:borderShift 10s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:.65;transition:opacity .4s var(--ease);
  pointer-events:none;will-change:background-position;
}
.team-card::after{
  content:'';position:absolute;inset:1.5px;border-radius:24.5px;
  background:
    radial-gradient(circle at 100% 0%, rgba(255,46,136,.10), transparent 50%),
    linear-gradient(180deg,rgba(18,18,22,.97),rgba(10,10,14,.99));
  z-index:-1;pointer-events:none;
}
.team-card:hover::before{opacity:1;}
.team-card:hover{
  transform:translateY(-6px);
  box-shadow:0 40px 80px -25px rgba(0,0,0,.9),0 0 60px -20px rgba(255,46,136,.4);
}
.team-card > *{position:relative;z-index:1;}
.team-card.programmer > *{position:relative;z-index:1;}
.team-watermark{
  position:absolute;top:20px;right:24px;
  font-family:'SF Mono',ui-monospace,Menlo,monospace;
  font-size:15px;font-weight:700;
  background:linear-gradient(90deg,#FF3B42,#FF2E88);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  opacity:.6;letter-spacing:.05em;transition:opacity .35s var(--ease);
  pointer-events:none;z-index:1;
}
.team-card:hover .team-watermark{opacity:1;}
.team-head{display:flex;align-items:center;gap:20px;margin-bottom:24px;position:relative;z-index:1;}
.team-avatar{
  width:100px;height:100px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--red),var(--purple));
  background-size:cover;background-position:center;
  border:2px solid rgba(255,255,255,.12);
  color:#fff;font-family:var(--font-display);font-weight:800;font-size:34px;
  letter-spacing:-.02em;flex-shrink:0;
  box-shadow:0 14px 40px rgba(255,46,136,.3),inset 0 1px 0 rgba(255,255,255,.15);
  transition:transform .4s var(--ease), box-shadow .4s var(--ease);position:relative;
}
.team-card:hover .team-avatar{
  transform:scale(1.06) rotate(-3deg);
  box-shadow:0 18px 50px rgba(255,46,136,.5),inset 0 1px 0 rgba(255,255,255,.15);
}
.team-avatar.avatar-image{
  background-image:url('https://i.imgur.com/Atlcrgs.png');
  background-color:#101013;
}
.team-name{
  font-family:var(--font-display);font-size:30px;font-weight:800;
  letter-spacing:-.03em;color:#fff;line-height:1.1;margin-bottom:6px;
}
.team-role{
  font-family:var(--font-body);font-size:11.5px;font-weight:700;
  letter-spacing:.14em;
  background:linear-gradient(90deg,var(--red),#FF2E88);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  text-transform:uppercase;
}
.team-desc{
  font-family:var(--font-body);font-size:15px;line-height:1.75;
  color:var(--text-dim);letter-spacing:-.005em;
  margin-bottom:24px;position:relative;z-index:1;
}
.team-badges{display:flex;flex-wrap:wrap;gap:7px;position:relative;z-index:1;}
.badge{
  display:inline-flex;align-items:center;gap:5px;
  font-family:var(--font-body);font-size:11.5px;font-weight:600;
  padding:6px 12px;background:rgba(255,255,255,.04);
  border:1px solid var(--border);border-radius:100px;
  color:var(--text-dim);letter-spacing:.02em;transition:all .3s var(--ease);
}
.badge svg{width:11px;height:11px;color:var(--red);}
.badge.highlight{
  background:linear-gradient(135deg, rgba(255,46,136,.15), rgba(123,47,190,.10));
  border-color:rgba(255,46,136,.4);color:#fff;
}
.badge.highlight svg{color:#FF2E88;}

/* ========== CTA ========== */
.cta-wrap{
  position:relative;border-radius:var(--radius-2xl);overflow:hidden;isolation:isolate;
  padding:1.5px;
}
.cta-wrap::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(255,59,66,.7) 60deg,
    rgba(255,46,136,.6) 120deg,
    rgba(123,47,190,.6) 180deg,
    rgba(0,180,220,.5) 240deg,
    rgba(255,46,136,.6) 300deg,
    transparent 360deg
  );
  animation:ctaSpin 14s linear infinite;will-change:transform;
}
@keyframes ctaSpin{to{transform:rotate(360deg);}}
.cta-wrap::after{
  content:'';position:absolute;inset:1.5px;z-index:-1;
  border-radius:calc(var(--radius-2xl) - 2px);
  background:
    radial-gradient(ellipse 70% 70% at 50% 50%, rgba(255,46,136,.10), transparent 70%),
    linear-gradient(180deg, #0F0F12, #0A0A0D);
}
.cta{
  position:relative;padding:80px 56px;text-align:center;
  border-radius:calc(var(--radius-2xl) - 2px);overflow:hidden;
}
.cta::after{
  content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:600px;height:600px;border-radius:50%;
  background:radial-gradient(circle, rgba(255,46,136,.15) 0%, transparent 60%);
  pointer-events:none;z-index:-1;filter:blur(50px);
  animation:ctaGlow 6s ease-in-out infinite;
}
@keyframes ctaGlow{
  0%,100%{opacity:.6;transform:translate(-50%,-50%) scale(1);}
  50%{opacity:1;transform:translate(-50%,-50%) scale(1.15);}
}
.cta-title{
  font-family:var(--font-display);
  font-size:clamp(1.9rem,3.6vw,2.7rem);font-weight:800;
  letter-spacing:-.03em;line-height:1.1;color:#fff;margin-bottom:16px;position:relative;
}
.cta-desc{
  font-family:var(--font-body);font-size:15.5px;color:var(--text-dim);
  line-height:1.7;max-width:540px;margin:0 auto 36px;letter-spacing:-.005em;position:relative;
}
.cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative;}

/* ========== PAGE HEADER ========== */
.page-head{
  padding:calc(var(--nav-h) + 96px) 0 56px;
  text-align:center;position:relative;overflow:hidden;
}
.page-head::before{
  content:'';position:absolute;top:0;left:0;right:0;bottom:0;
  background-image:url('https://images.unsplash.com/photo-1522383225653-ed111181a951?w=1600&q=70&auto=format&fit=crop');
  background-size:cover;background-position:center;opacity:.10;
  filter:grayscale(.5) brightness(.35);pointer-events:none;z-index:0;
}
.page-head::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,transparent 20%,var(--bg) 100%);
  pointer-events:none;z-index:0;
}
.page-head .container{position:relative;z-index:1;}
.page-head .sec-head{margin-bottom:0;text-align:center;margin-left:auto;margin-right:auto;}

/* ========== TIENDA ========== */
.coming{
  min-height:calc(100vh - var(--nav-h));
  display:flex;align-items:center;justify-content:center;
  padding:calc(var(--nav-h) + 40px) 24px 80px;
  text-align:center;position:relative;overflow:hidden;
}
.coming::before{
  content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:min(640px,90vw);height:min(640px,90vw);
  border-radius:50%;border:1px solid rgba(255,46,136,.10);
  pointer-events:none;animation:rotSlow 50s linear infinite;
}
.coming::after{
  content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:min(420px,60vw);height:min(420px,60vw);
  border-radius:50%;border:1px dashed rgba(255,46,136,.12);
  pointer-events:none;animation:rotSlow 80s linear infinite reverse;
}
@keyframes rotSlow{to{transform:translate(-50%,-50%) rotate(360deg);}}
.coming-inner{max-width:560px;position:relative;z-index:1;}
.coming-icon{
  width:80px;height:80px;margin:0 auto 28px;
  display:flex;align-items:center;justify-content:center;
  border-radius:20px;
  background:linear-gradient(180deg,rgba(255,46,136,.18),rgba(123,47,190,.08));
  border:1px solid rgba(255,46,136,.35);color:#FF2E88;
  box-shadow:0 20px 50px -10px rgba(255,46,136,.4);
}
.coming-icon svg{width:32px;height:32px;}
.coming-badge{
  display:inline-flex;align-items:center;gap:8px;padding:8px 18px;
  font-family:var(--font-body);font-size:11px;font-weight:700;
  letter-spacing:.18em;text-transform:uppercase;color:#FF2E88;
  background:rgba(255,46,136,.10);border:1px solid rgba(255,46,136,.35);
  border-radius:100px;margin-bottom:28px;
}
.coming-badge .dot{
  width:6px;height:6px;border-radius:50%;background:#FF2E88;
  box-shadow:0 0 10px #FF2E88;animation:pulseDot 1.8s ease-in-out infinite;
}
.coming-title{
  font-family:var(--font-display);
  font-size:clamp(2rem,4.6vw,3.2rem);font-weight:800;
  letter-spacing:-.04em;line-height:1.08;color:#fff;margin-bottom:18px;
}
.coming-desc{
  font-family:var(--font-body);font-size:15.5px;line-height:1.75;
  color:var(--text-dim);max-width:480px;margin:0 auto 34px;letter-spacing:-.005em;
}

/* ========== INFO ========== */
.info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;position:relative;z-index:2;}
.info-card{
  padding:36px 32px;
  border-radius:var(--radius-lg);
  transition:all .4s var(--ease);position:relative;overflow:hidden;
  isolation:isolate;
}
.info-card::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg, rgba(255,59,66,.6), rgba(255,46,136,.5), rgba(123,47,190,.4), rgba(0,180,220,.3), rgba(255,59,66,.6));
  background-size:300% 300%;
  animation:borderShift 14s ease infinite;
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .4s var(--ease);
  pointer-events:none;will-change:background-position;
}
.info-card::after{
  content:'';position:absolute;inset:1px;border-radius:calc(var(--radius-lg) - 1px);
  background:linear-gradient(180deg, rgba(20,20,24,.96), rgba(12,12,16,.99));
  z-index:-1;pointer-events:none;
}
.info-card:hover::before{opacity:1;}
.info-card:hover{
  transform:translateY(-4px);
  box-shadow:0 20px 50px -20px rgba(0,0,0,.7),0 0 30px -15px rgba(255,46,136,.2);
}
.info-card > *{position:relative;z-index:1;}
.info-icon{
  width:50px;height:50px;display:flex;align-items:center;justify-content:center;
  border-radius:13px;
  background:linear-gradient(135deg, rgba(255,46,136,.18), rgba(123,47,190,.10));
  border:1px solid rgba(255,46,136,.35);color:#FF2E88;
  margin-bottom:22px;transition:all .4s var(--ease);
  box-shadow:0 8px 20px -8px rgba(255,46,136,.4);
}
.info-card:hover .info-icon{
  transform:scale(1.08) rotate(-4deg);
  box-shadow:0 12px 28px -8px rgba(255,46,136,.6);
}
.info-icon svg{width:22px;height:22px;}
.info-card h3{
  font-family:var(--font-display);font-size:18px;font-weight:700;
  letter-spacing:-.015em;color:#fff;margin-bottom:10px;
}
.info-card p{
  font-family:var(--font-body);font-size:14px;line-height:1.75;
  color:var(--text-dim);letter-spacing:-.005em;
}

/* ========== FOOTER ========== */
.footer{
  border-top:1px solid var(--border);
  padding:80px 0 40px;margin-top:60px;
  background:
    radial-gradient(ellipse 60% 50% at 50% 0%, rgba(255,46,136,.06), transparent 70%),
    linear-gradient(180deg,rgba(255,255,255,.012),transparent);
  position:relative;overflow:hidden;
}
.footer::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,59,66,.5),rgba(255,46,136,.4),rgba(123,47,190,.3),transparent);
}
.footer-grid{
  display:grid;grid-template-columns:1.6fr 1fr 1fr 1.3fr;
  gap:52px;margin-bottom:52px;
}
.footer-brand .nav-brand{margin-bottom:20px;}
.footer-brand p{
  font-family:var(--font-body);font-size:13.5px;line-height:1.7;
  color:var(--text-dim);max-width:340px;letter-spacing:-.005em;
}
.footer-col h4{
  font-family:var(--font-body);font-size:10.5px;font-weight:700;
  letter-spacing:.16em;color:var(--text-mute);text-transform:uppercase;margin-bottom:18px;
}
.footer-col a,.footer-col .footer-line{
  display:flex;align-items:center;gap:7px;
  font-family:var(--font-body);font-size:13.5px;color:var(--text-dim);
  padding:7px 0;transition:color .22s;letter-spacing:-.005em;
}
.footer-col a:hover{color:#fff;}
.footer-col a svg{width:13px;height:13px;opacity:.6;}
.footer-ip{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin-bottom:8px;padding:10px 13px;
  background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:9px;
  font-family:'SF Mono',ui-monospace,Menlo,monospace;
  font-size:12px;color:#fff;cursor:pointer;
  transition:all .22s var(--ease);width:100%;
}
.footer-ip:hover{
  background:rgba(255,46,136,.06);
  border-color:rgba(255,46,136,.4);
}
.footer-ip .ip-label{
  font-family:var(--font-body);font-size:9.5px;font-weight:700;
  letter-spacing:.12em;color:var(--text-mute);text-transform:uppercase;
  margin-right:4px;flex-shrink:0;
}
.footer-ip .ip-text{
  flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  text-align:left;letter-spacing:.01em;
}
.footer-ip svg{width:13px;height:13px;color:var(--text-mute);flex-shrink:0;}
.footer-ip:hover svg{color:#FF2E88;}
.footer-bottom{
  padding-top:26px;border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  font-family:var(--font-body);font-size:12.5px;color:var(--text-mute);letter-spacing:-.005em;
}
.footer-tag{
  display:flex;align-items:center;gap:7px;
  font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;
}
.footer-tag .dot{
  width:6px;height:6px;border-radius:50%;background:#FF2E88;
  box-shadow:0 0 8px #FF2E88;animation:pulseDot 2s ease-in-out infinite;
}

/* ========== RESPONSIVE ========== */
@media (max-width:1024px){
  .nav-links{display:none;}
  .nav-toggle{display:flex;}
  .about-grid{grid-template-columns:1fr;gap:52px;}
  .about-visual{max-width:560px;margin:0 auto;width:100%;}
  .info-grid{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr 1fr;gap:36px;}
  .footer-brand{grid-column:1 / -1;}
  .studio-tiers{grid-template-columns:repeat(2,1fr);}
  .studio-features{grid-template-columns:repeat(2,1fr);}
  .studio-preview{grid-template-columns:repeat(3,1fr);}
  .tier-netherite-featured{grid-template-columns:1fr;gap:32px;padding:36px 32px;}
  .netherite-side{width:100%;max-width:320px;margin:0 auto;}
  .netherite-benefits{grid-template-columns:1fr;}
}
@media (max-width:820px){
  .team-grid{grid-template-columns:1fr;max-width:520px;}
  .grid-2{grid-template-columns:1fr;}
  .conn-grid{grid-template-columns:1fr;}
}
@media (max-width:768px){
  :root{--nav-h:64px;}
  .container{padding:0 20px;}
  .navbar{padding:0 16px;}
  .nav-brand .brand-name{font-size:16px;}
  .nav-brand .brand-logo{width:34px;height:34px;}
  .section{padding:80px 0;}
  .section-sm{padding:56px 0;}
  .hero{padding:calc(var(--nav-h) + 40px) 20px 64px;}
  .hero-actions{flex-direction:column;max-width:340px;margin-left:auto;margin-right:auto;}
  .hero-actions .btn{width:100%;}
  .hero-logo img{height:76px;max-width:200px;}
  .hero-logo .fallback{width:72px;height:72px;font-size:32px;}
  .about-stats{grid-template-columns:1fr;gap:12px;}
  .stat{padding:18px;display:flex;align-items:center;gap:16px;text-align:left;}
  .stat-num{margin-bottom:0;font-size:20px;}
  .footer-grid{grid-template-columns:1fr;gap:32px;}
  .footer-bottom{flex-direction:column;text-align:center;}
  .page-head{padding:calc(var(--nav-h) + 64px) 0 32px;}
  .coming{padding:calc(var(--nav-h) + 30px) 20px 60px;}
  .cta{padding:56px 26px;}
  .cta-wrap{border-radius:20px;}
  .community-card{padding:30px;}
  .team-card{padding:36px 28px;}
  .team-avatar{width:84px;height:84px;font-size:28px;}
  .team-name{font-size:26px;}
  .info-card{padding:28px;}
  .hero-blob.blob-red,.hero-blob.blob-purple,.hero-blob.blob-cyan,.hero-blob.blob-pink{animation-duration:40s;}
  .section-about-orb{filter:blur(40px);}
  .studio-discord-cta{padding:36px 24px;}
}
@media (max-width:520px){
  .studio-tiers{grid-template-columns:1fr;}
  .studio-features{grid-template-columns:1fr;}
  .studio-preview{grid-template-columns:repeat(2,1fr);}
  .sec-title{font-size:1.8rem;}
  .hero-title{font-size:clamp(2.4rem,11vw,3rem);}
  .nav-brand .brand-name{font-size:15px;}
  .conn-card{padding:14px 16px 12px;}
  .conn-field-value{font-size:12.5px;}
  .team-name{font-size:22px;}
  .team-avatar{width:76px;height:76px;font-size:26px;}
  .community-title{font-size:21px;}
  .tier-netherite-featured{padding:28px 22px;gap:24px;}
  .netherite-price{font-size:30px;}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:.01ms !important;animation-iteration-count:1 !important;
    transition-duration:.01ms !important;scroll-behavior:auto !important;
  }
  body::before{display:none;}
  .reveal{opacity:1;transform:none;}
  .hero-bg-layer{animation:none;transform:scale(1.05);}
  .petal{display:none;}
  .hero-blob{animation:none;}
  .hero-accent-rgb,.sec-title .accent-rgb,.nav-brand .brand-name em,.netherite-title,.netherite-price{
    -webkit-text-fill-color:var(--red);color:var(--red);background:none;
  }
  .team-card::before,.community-card::before,.info-card::before,.conn-card::before,.tier-card::before,.tier-mini::before,.feature-card::before,.studio-discord-cta::before,.about-visual::before{animation:none;}
  .cta-wrap::before,.tier-netherite-featured::before{animation:none;}
  .cta::after,.netherite-icon-large{animation:none;}
  .section-about-orb{animation:none;}
}
</style>
</head>
<body>

<div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="#/" class="nav-brand" id="navBrand" aria-label="KorianMC - Inicio">
      <img class="brand-logo" src="https://i.imgur.com/gr2YMP6.png" alt="KorianMC" onerror="document.getElementById('navBrand').classList.add('no-img')">
      <span class="brand-fallback">K</span>
      <span class="brand-name">KORIAN<em>MC</em></span>
    </a>
    <div class="nav-links">
      <a href="#/" class="nav-link" data-route="inicio">Inicio</a>
      <a href="#/studio" class="nav-link" data-route="studio">Studio</a>
      <a href="#/comunidad" class="nav-link" data-route="comunidad">Comunidad</a>
      <a href="#/equipo" class="nav-link" data-route="equipo">Equipo</a>
      <a href="#/tienda" class="nav-link" data-route="tienda">Tienda</a>
      <a href="#/informacion" class="nav-link" data-route="informacion">Información</a>
    </div>
    <button class="nav-toggle" id="navToggle" aria-label="Menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-inner">
    <a href="#/" class="mobile-link" data-route="inicio">Inicio <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="#/studio" class="mobile-link" data-route="studio">Studio <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="#/comunidad" class="mobile-link" data-route="comunidad">Comunidad <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="#/equipo" class="mobile-link" data-route="equipo">Equipo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="#/tienda" class="mobile-link" data-route="tienda">Tienda <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="#/informacion" class="mobile-link" data-route="informacion">Información <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></a>
    <div class="mobile-footer">KORIANMC</div>
  </div>
</div>

<main id="app">

  <!-- ========== PAGE: INICIO ========== -->
  <section class="page" data-page="inicio">

    <div class="hero">
      <div class="hero-bg-layer"></div>
      <div class="hero-overlay-1"></div>
      <div class="hero-blobs" aria-hidden="true">
        <div class="hero-blob blob-red"></div>
        <div class="hero-blob blob-purple"></div>
        <div class="hero-blob blob-cyan"></div>
        <div class="hero-blob blob-pink"></div>
      </div>
      <div class="hero-overlay-2"></div>
      <div class="hero-particles" aria-hidden="true">
        <span class="petal"></span><span class="petal"></span><span class="petal"></span>
        <span class="petal"></span><span class="petal"></span><span class="petal"></span>
      </div>

      <div class="hero-inner">
        <div class="hero-logo">
          <img src="https://i.imgur.com/gr2YMP6.png" alt="KorianMC" onerror="this.parentElement.classList.add('no-img')">
          <div class="fallback">K</div>
        </div>

        <div class="hero-eyebrow">
          <span class="dot"></span>
          JAVA &amp; BEDROCK
        </div>

        <h1 class="hero-title">Tu aventura<br>comienza <span class="hero-accent-rgb">aquí</span>.</h1>

        <p class="hero-desc">Una network de Minecraft con identidad japonesa. Explora, construye y comparte tu historia con una comunidad que crece cada día.</p>

        <div class="hero-actions">
          <a href="#/studio" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            Explorar Studio
          </a>
          <a href="#/comunidad" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Unirse a la comunidad
          </a>
        </div>

        <div class="conn-grid">
          <div class="conn-card">
            <div class="conn-label">
              <span class="edition-tag">JAVA</span>
              EDITION
            </div>
            <div class="conn-field">
              <span class="conn-field-label">IP</span>
              <div class="conn-field-value">
                <span class="ip-text">korianmc.bean.pe</span>
                <button class="conn-copy" onclick="copyIP(this, 'korianmc.bean.pe')" aria-label="Copiar IP Java">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </div>
            </div>
            <div class="conn-field">
              <span class="conn-field-label">VERSIÓN</span>
              <div class="conn-field-value">
                <span class="port-text">1.21.x</span>
              </div>
            </div>
            <div class="conn-status">
              <span class="status-dot"></span>
              Servidor online
            </div>
          </div>

          <div class="conn-card">
            <div class="conn-label">
              <span class="edition-tag">BEDROCK</span>
              EDITION
            </div>
            <div class="conn-field">
              <span class="conn-field-label">IP</span>
              <div class="conn-field-value">
                <span class="ip-text">korianmcbedrock.bean.pe</span>
                <button class="conn-copy" onclick="copyIP(this, 'korianmcbedrock.bean.pe')" aria-label="Copiar IP Bedrock">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </div>
            </div>
            <div class="conn-field">
              <span class="conn-field-label">PUERTO</span>
              <div class="conn-field-value">
                <span class="port-text">25585</span>
                <button class="conn-copy" onclick="copyIP(this, '25585')" aria-label="Copiar puerto Bedrock">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </div>
            </div>
            <div class="conn-status">
              <span class="status-dot"></span>
              Servidor online
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="section section-about">
      <div class="section-about-orb" aria-hidden="true"></div>
      <div class="section-about-orb orb-2" aria-hidden="true"></div>
      <div class="section-about-orb orb-3" aria-hidden="true"></div>
      <div class="container">
        <div class="about-grid">
          <div class="about-body reveal reveal-left">
            <div class="sec-head">
              <span class="sec-label">SOBRE KORIANMC</span>
              <h2 class="sec-title">Una network con <span class="accent-rgb">identidad propia</span>.</h2>
            </div>
            <p>KorianMC es una network de Minecraft donde la esencia del juego se mezcla con una estética inspirada en Japón. Un lugar pensado para quienes disfrutan explorar, construir y compartir cada partida con otros jugadores.</p>
            <p>Construimos un servidor serio y organizado, con espacio para todos, ya sea en Java o en Bedrock. Nuestro Studio complementa la experiencia con recursos exclusivos para tu propio servidor.</p>
            <div class="about-stats">
              <div class="stat">
                <div class="stat-num">2</div>
                <div class="stat-lbl">Ediciones</div>
              </div>
              <div class="stat">
                <div class="stat-num">5</div>
                <div class="stat-lbl">Rangos Studio</div>
              </div>
              <div class="stat">
                <div class="stat-num">100<span class="accent">%</span></div>
                <div class="stat-lbl">Dedicación</div>
              </div>
            </div>
          </div>

          <div class="about-visual reveal reveal-right" id="aboutVisual">
            <img src="https://i.imgur.com/qY4Qzlx.png" alt="KorianMC" class="about-img" loading="lazy" onerror="document.getElementById('aboutVisual').classList.add('no-img')">
            <div class="about-img-fallback" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-studio">
      <div class="container">
        <div class="sec-head center reveal reveal-up">
          <span class="sec-label">STUDIO</span>
          <h2 class="sec-title">KorianMC <span class="accent-rgb">Studio</span></h2>
          <p class="sec-desc">Recursos exclusivos para tu propio servidor. Consigue rangos invitando jugadores a la network o accede a todo con la suscripción premium Netherite.</p>
        </div>

        <div class="studio-preview reveal reveal-up">
          <div class="tier-mini tier-copper">
            <div class="tier-mini-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </div>
            <div class="tier-mini-name">Cobre</div>
            <div class="tier-mini-req">3 invitaciones</div>
          </div>
          <div class="tier-mini tier-carbon">
            <div class="tier-mini-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </div>
            <div class="tier-mini-name">Carbón</div>
            <div class="tier-mini-req">5 invitaciones</div>
          </div>
          <div class="tier-mini tier-iron">
            <div class="tier-mini-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
            </div>
            <div class="tier-mini-name">Hierro</div>
            <div class="tier-mini-req">8 invitaciones</div>
          </div>
          <div class="tier-mini tier-diamond">
            <div class="tier-mini-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
            </div>
            <div class="tier-mini-name">Diamante</div>
            <div class="tier-mini-req">15 invitaciones</div>
          </div>
          <div class="tier-mini tier-netherite">
            <div class="tier-mini-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"/><path d="M5 16v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2"/></svg>
            </div>
            <div class="tier-mini-name">Netherite</div>
            <div class="tier-mini-req">$8 USD/mes</div>
          </div>
        </div>

        <div style="text-align:center;" class="reveal reveal-up">
          <a href="#/studio" class="btn btn-primary">Explorar Studio</a>
        </div>
      </div>
    </section>

    <section class="section section-community">
      <div class="container">
        <div class="sec-head center reveal reveal-up">
          <span class="sec-label">COMUNIDAD</span>
          <h2 class="sec-title">Dos comunidades, una <span class="accent-rgb">network</span></h2>
          <p class="sec-desc">KorianMC se divide en dos comunidades independientes. Cada jugador encuentra su espacio según la edición que utilice.</p>
        </div>

        <div class="grid-2">
          <article class="community-card java reveal reveal-left">
            <div class="community-head">
              <div class="community-icon">
                <svg viewBox="0 0 127.14 96.36" fill="currentColor"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
              </div>
              <div>
                <span class="community-tag">DISCORD JAVA</span>
                <h3 class="community-title">Comunidad Java</h3>
              </div>
            </div>
            <p class="community-desc">La comunidad de KorianMC para Java Edition. Un espacio para conocer nuevos jugadores, participar en la conversación y estar al día de todo lo que ocurre en el servidor.</p>
            <a href="https://discord.gg/kxNCz6jZTE" target="_blank" rel="noopener noreferrer" class="btn btn-discord">
              <svg viewBox="0 0 127.14 96.36" fill="currentColor" style="width:16px;height:16px;"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
              Unirse a Java
            </a>
          </article>

          <article class="community-card bedrock reveal reveal-right">
            <div class="community-head">
              <div class="community-icon">
